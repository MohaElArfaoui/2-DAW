    "class Clasificacion:\n",
    "    def __init__(self, equipo=\"\", puntos=0):\n",
    "        self.equipo= equipo\n",
    "        self. puntos=puntos\n",
    "\n",
    "    def __str__(self):\n",
    "        return (\"{}, {} puntos\".format(self.equipo,self.puntos))\n",
    "\n",
    "def mostrarMenu():\n",
    "        print(\"Menu\")\n",
    "        print(\"1.- Mostrar clasificación.\")  \n",
    "        print(\"2.- Mostrar mejor equipo.\")   \n",
    "        print(\"3.- Mostrar peor equipo.\")   \n",
    "        print(\"4.- Salir..\")\n",
    "\n",
    "def obtenerPuntos(equipo):\n",
    "    return equipo.puntos\n",
    "        \n",
    "opcion=\"s\"\n",
    "equipos= [Clasificacion(\"Real betis\", 24)]\n",
    "\n",
    "while(opcion==\"s\"):\n",
    "    opcion=input(\"¿Quieres añadir otro equipo(s/n)\")\n",
    "    if opcion!=\"s\" and opcion!=\"n\":\n",
    "        print(\"opcion incorrecta\")\n",
    "        opcion=\"s\"\n",
    "                \n",
    "    elif opcion==\"s\":\n",
    "        nombre= input(\"Introduce el nombre del equipo: \")\n",
    "        puntos= int(input(\"Introduce sus puntos: \"))\n",
    "        equipos.append(Clasificacion(nombre,puntos))\n",
    "    elif opcion==\"n\":\n",
    "        while True:\n",
    "            mostrarMenu()\n",
    "            opcionMenu=input(\"Elige una opcion del menu\")\n",
    "                    \n",
    "            if opcionMenu==\"1\":\n",
    "                           \n",
    "                    equipos.sort(key=obtenerPuntos, reverse=True)\n",
    "                    posicion=1\n",
    "                    for e in equipos:\n",
    "                        print(posicion, e)\n",
    "                        posicion+=1\n",
    "            elif opcionMenu==\"2\":\n",
    "                    equipos.sort(key=obtenerPuntos, reverse=True)\n",
    "                    print(\"Mejor equipo:\", equipos[0])\n",
    "            elif opcionMenu==\"3\":\n",
    "                    equipos.sort(key=obtenerPuntos)\n",
    "                    print(\"Peor equipo:\", equipos[0])\n",
    "            elif opcionMenu==\"4\":\n",
    "                    print(\"Saliendo...\")\n",
    "                    break\n",
    "            else:\n",
    "                    print(\"Opcion no valida\")\n",
    "                            \n",
    "                   \n",
    "                "
   ]

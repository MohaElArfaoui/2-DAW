    "dict_agenda ={}\n",
    "\n",
    "def menuAgenda():\n",
    "    print(\"Menu\")\n",
    "    print(\"1.- Añadir/modificar.\")\n",
    "    print(\"2.- Buscar.\")   \n",
    "    print(\"3.- Borrar.\")   \n",
    "    print(\"4.- Listar\")\n",
    "    print(\"5.- Salir\")\n",
    "\n",
    "while True:\n",
    "        menuAgenda()\n",
    "        opcion= input(\"Introduce una opcion\")\n",
    "        if opcion == \"1\":\n",
    "            nombre=input(\"Introduce un nombre para anotar en la agenda\")\n",
    "            if nombre in dict_agenda:\n",
    "                print(\"Contacto existente\")\n",
    "            else:\n",
    "                telf=int(input(\"Introduce su numero de telefono\"))\n",
    "                dict_agenda[nombre]=telf\n",
    "        elif opcion == \"2\":\n",
    "            cadena=input(\"Introduce una cadena de caracteres para buscar coincidencias\")\n",
    "            encontrado= False\n",
    "            for nombre, telf in dict_agenda.items():\n",
    "                 if cadena in nombre:\n",
    "                        print (nombre, telf)\n",
    "                        encontrado=True\n",
    "            if not encontrado:\n",
    "                     print(\"No se ha encontrado ninguna coincidencia\")\n",
    "                    \n",
    "        elif opcion==\"3\":\n",
    "            nombre=input(\"Introduce un nombre para borrar de la agenda\")   \n",
    "            if nombre in dict_agenda:\n",
    "                confirmar= input(\"Quieres borrarlo de la agenda s/n\")    \n",
    "                if confirmar==\"s\":\n",
    "                    del dict_agenda[nombre]\n",
    "                    print(nombre, \"se ha borrado correctamente\")\n",
    "                elif confirmar==\"n\":\n",
    "                        print(\"No se ha borrado de la agenda\")\n",
    "                else:\n",
    "                        print(\"Opcion incorrecta\")\n",
    "            else:\n",
    "                print(\"No existe ese nombre\")\n",
    "                    \n",
    "        elif opcion==\"4\":\n",
    "            if not dict_agenda:\n",
    "                print(\"La agenda esta vacia\")\n",
    "            for nombre, telf in dict_agenda.items():\n",
    "                print(nombre, telf)\n",
    "\n",
    "        elif opcion ==\"5\":\n",
    "            print(\"Saliendo...\")\n",
    "            break\n",
    "        else:\n",
    "            print(\"Opcion Incorrecta\")\n",
